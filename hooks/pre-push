#!/usr/bin/env bash
# Git hook: pre-push  
# Auto-sync git notes before push operations
# Installed by: git issue setup-sync

# Colors for output
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Prevent recursive invocation (git push inside hook re-triggers hook)
if [[ -n "$GIT_ISSUE_PUSHING_NOTES" ]]; then
    exit 0
fi
export GIT_ISSUE_PUSHING_NOTES=1

# Hook receives remote name and URL as arguments
REMOTE="$1"
URL="$2"

# Check if git-issue notes sync is enabled
if ! git config --get-regexp "git-issue" | grep -q "sync.enabled.*true"; then
    exit 0
fi

# Only sync notes in git repositories (skip XDG mode)
if ! git rev-parse --git-dir >/dev/null 2>&1; then
    exit 0
fi

# Check if we have any issue notes to push
NOTE_REFS=$(git for-each-ref --format="%(refname)" refs/notes/issue-* 2>/dev/null)
if [[ -z "$NOTE_REFS" ]]; then
    # No issue notes to push
    exit 0
fi

# Find notes that changed since last push by comparing local vs remote refs.
# This avoids pushing all N notes every time.
CHANGED_REFS=""
while IFS= read -r ref; do
    local_sha=$(git rev-parse "$ref" 2>/dev/null)
    remote_sha=$(git rev-parse "refs/remotes/$REMOTE/${ref#refs/}" 2>/dev/null || \
                 git ls-remote --refs "$REMOTE" "$ref" 2>/dev/null | awk '{print $1}')
    if [[ "$local_sha" != "$remote_sha" ]]; then
        CHANGED_REFS="${CHANGED_REFS}${ref}"$'\n'
    fi
done <<< "$NOTE_REFS"

# Strip trailing newline and check if anything changed
CHANGED_REFS=$(echo "$CHANGED_REFS" | grep -v '^$')
if [[ -z "$CHANGED_REFS" ]]; then
    exit 0
fi

CHANGED_COUNT=$(echo "$CHANGED_REFS" | wc -l | tr -d ' ')
NOTE_COUNT=$(echo "$NOTE_REFS" | wc -l | tr -d ' ')
echo -e "${BLUE}🔄 Pushing $CHANGED_COUNT/$NOTE_COUNT changed issue notes to $REMOTE...${NC}"

# Build refspec list for only changed refs
REFSPECS=()
while IFS= read -r ref; do
    [[ -z "$ref" ]] && continue
    REFSPECS+=("$ref")
done <<< "$CHANGED_REFS"

# Not --atomic: an issue edited here and on the remote since the last push
# is rejected as a non-fast-forward, and an atomic push would hold back every
# other changed issue with it. Name the rejected ones, as post-merge does.
PUSH_OUT=$(git push "$REMOTE" "${REFSPECS[@]}" 2>&1)
PUSH_RC=$?
REJECTED=$(echo "$PUSH_OUT" | grep '\[rejected\]' | grep -o 'refs/notes/issue-[0-9a-f]*' | sort -u)
if [[ -n "$REJECTED" ]]; then
    REJECTED_COUNT=$(echo "$REJECTED" | wc -l | tr -d ' ')
    echo -e "${GREEN}✓ Pushed $((CHANGED_COUNT - REJECTED_COUNT)) issue notes${NC}"
    echo -e "${YELLOW}⚠️  Issue notes diverged from $REMOTE (not pushed):${NC}"
    echo "$REJECTED" | sed 's/^/     /'
    echo -e "${YELLOW}   Keep yours: git push --force $REMOTE refs/notes/issue-<id>${NC}"
    echo -e "${YELLOW}   Take theirs: git fetch $REMOTE +refs/notes/issue-<id>:refs/notes/issue-<id>${NC}"
elif [[ $PUSH_RC -eq 0 ]]; then
    echo -e "${GREEN}✓ Successfully pushed $CHANGED_COUNT issue notes${NC}"
else
    echo "$PUSH_OUT"
    echo -e "${YELLOW}⚠️  Failed to push issue notes (this may be normal for new remotes)${NC}"
    # Don't fail the push - notes sync failure shouldn't block code push
    exit 0
fi

# Optional: push commit notes too if they exist
if git rev-parse refs/notes/commits >/dev/null 2>&1; then
    git push "$REMOTE" refs/notes/commits 2>/dev/null || true
fi

exit 0