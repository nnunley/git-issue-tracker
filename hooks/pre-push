#!/usr/bin/env bash
# Git hook: pre-push
# Push the issue refs that changed along with every push, without force.
# Installed by: git issue setup-sync
#
# An issue ref is pushed when it differs from the remote's copy as last seen
# (refs/issue-remotes/<remote>/issue-<id>, filled by fetch and by this hook)
# or when there is no copy yet. The push has no "+", so an issue that has
# diverged from the remote's copy is rejected like a diverged branch; the
# hook then names it, says to run `git issue sync <remote>`, and fails the
# push. GIT_ISSUE_PUSH_SOFT=1 warns instead and lets the push proceed.

BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Prevent recursive invocation (git push inside hook re-triggers hook)
if [[ -n "$GIT_ISSUE_PUSHING_NOTES" ]]; then
    exit 0
fi
export GIT_ISSUE_PUSHING_NOTES=1

# Hook receives remote name (or URL) and URL as arguments
REMOTE="$1"

if ! git config --get-regexp "git-issue" | grep -q "sync.enabled.*true"; then
    exit 0
fi
if ! git rev-parse --git-dir >/dev/null 2>&1; then
    exit 0
fi

# The remote refs this push already updates (git passes them on stdin): an
# issue ref named on the command line is git's to push, not the hook's
NAMED=$(awk '{print $3}')

# The issue refs that differ from the remote's copy, as "<ref> <sha>": one
# for-each-ref over both namespaces, no network round trip. A ref the
# remote's copy already contains (a fetch moved the copy on, and nothing
# synced yet) has nothing to send, so it is left out rather than refused.
TRACK="refs/issue-remotes/$REMOTE/issue-"
CHANGED=$(git for-each-ref --format='%(refname) %(objectname)' 'refs/notes/issue-*' "${TRACK}*" 2>/dev/null \
    | awk -v t="$TRACK" '
        index($1, t) == 1 { seen[substr($1, length(t) + 1)] = $2; next }
        { id = $1; sub(/^refs\/notes\/issue-/, "", id); ref[id] = $1; sha[id] = $2 }
        END { for (id in ref) if (!(id in seen) || seen[id] != sha[id]) print ref[id], sha[id], ((id in seen) ? seen[id] : "-") }' \
    | while read -r ref sha theirs; do
        grep -qxF "$ref" <<< "$NAMED" && continue
        [[ "$theirs" != "-" ]] && git merge-base --is-ancestor "$sha" "$theirs" 2>/dev/null && continue
        echo "$ref $sha"
      done)
[[ -z "$CHANGED" ]] && exit 0

COUNT=$(printf '%s\n' "$CHANGED" | wc -l | tr -d ' ')
echo -e "${BLUE}🔄 Pushing $COUNT changed issue notes to $REMOTE...${NC}" >&2

REFSPECS=()
while read -r ref _; do
    REFSPECS+=("$ref:$ref")
done <<< "$CHANGED"

if OUT=$(git push --porcelain --atomic "$REMOTE" "${REFSPECS[@]}" 2>&1); then
    # Record what the remote now has, so the next push compares against it
    # (not for a push to a bare URL, which has no tracking namespace)
    if git check-ref-format "${TRACK}x"; then
        while read -r ref sha; do
            git update-ref "$TRACK${ref#refs/notes/issue-}" "$sha"
        done <<< "$CHANGED"
    fi
    echo -e "${GREEN}✓ Pushed $COUNT issue notes${NC}" >&2
else
    # The issues the remote refused because its copy moved on: only those
    # fail the push. Any other refusal (a remote that takes no notes, no
    # permission, no network) is a warning, and the code push goes ahead.
    REJECTED=$(printf '%s\n' "$OUT" | awk -F'\t' '$1 == "!" && $3 ~ /non-fast-forward|fetch first|stale info/ { split($2, a, ":"); id = a[1]; sub(/^refs\/notes\/issue-/, "", id); print id }')
    if [[ -z "$REJECTED" ]]; then
        echo -e "${YELLOW}⚠️  Could not push issue notes to $REMOTE; pushing the code anyway:${NC}" >&2
        printf '%s\n' "$OUT" | grep -v '^To \|^Done$' | sed 's/^/   /' >&2
        exit 0
    fi
    echo -e "${RED}✗ $REMOTE refused issue notes that have diverged from its copy: $(echo $REJECTED)${NC}" >&2
    echo -e "${YELLOW}  run \`git issue sync $REMOTE\` first${NC}" >&2
    if [[ -n "$GIT_ISSUE_PUSH_SOFT" ]]; then
        exit 0
    fi
    exit 1
fi

# Optional: push commit notes too if they exist
if git rev-parse -q --verify refs/notes/commits >/dev/null 2>&1; then
    git push "$REMOTE" refs/notes/commits 2>/dev/null || true
fi

exit 0
