#!/usr/bin/env bash
# Git hook: post-merge
# After a pull, fetch the remote's issues and merge them with yours.
# Installed by: git issue setup-sync
#
# The remote is the current branch's upstream remote, else every remote
# setup-sync configured. `git issue sync` never writes over a local edit:
# it fast-forwards, merges, or reports a conflict. A failed sync never fails
# the merge, which has already happened.

if ! git config --get-regexp "git-issue" | grep -q "sync.enabled.*true"; then
    exit 0
fi
if ! git rev-parse --git-dir >/dev/null 2>&1; then
    exit 0
fi

branch=$(git symbolic-ref -q --short HEAD 2>/dev/null)
remote=""
[[ -n "$branch" ]] && remote=$(git config --get "branch.$branch.remote" 2>/dev/null)
[[ "$remote" == "." ]] && remote=""

if [[ -n "$remote" ]]; then
    git issue sync "$remote" || true
else
    git issue sync || true
fi
exit 0
